attrcolor b ".I"
#termcapinfo * 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
defbce on
backtick 0 5 5 "/usr/bin/date" '+%m/%d (%a)'
backtick 1 5 5 "/usr/bin/date" '+%H%M'
hardstatus alwaysfirstline
hardstatus string '%{= kW}[%{W} GNU screen %{W}]%{W} %< %{kW}%?%-Lw%?%{= kB}(== %{W}%n*%f %t%?(%u)%? %{kB}==)%{= kW}%?%+Lw%?%? %= %{kW}[%{W}%0` %{W}%1`%{kW}]'
altscreen on
bind 0 select 10
bind c screen 1
defscrollback 5000
escape ^@a
maptimeout 0
screen 1
startup_message off
