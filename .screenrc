attrcolor b ".I"
#termcapinfo * 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
defbce on
#hardstatus alwaysfirstline
#hardstatus string '%{= kW}[%{W} GNU screen %{W}]%{W} %< %{kW}%?%-Lw%?%{= kB}(== %{W}%n*%f %t%?(%u)%? %{kB}==)%{= kW}%?%+Lw%?%? %= %{kW}[%{W}%0` %{W}%1`%{kW}]'
maptimeout 0


#bind -r r source-file ~/.tmux.conf \; run-shell "echo ----Reload tmux.conf----" \;
#bind -r f run-shell "tmux neww -n tmux-sessionizer tmux-sessionizer"
#bind -r e run-shell "tmux neww -n tmux-session-selector tmux-session-selector"
bind e screen -t screen-session-selector 1 "screen-session-selector"
bind y screen -t y 1 vim -c "set buftype=nofile" -c "set viminfo=" ${HOME}/y
bind [ eval "hardcopy ${HOME}/.vim/.hardcopy" "screen -t hardcopy 1 vim -c 'set buftype=nofile' -c 'set viminfo=' ${HOME}/.vim/.hardcopy"

screen 1
escape "^S^S"
bind 0 select 10
bind c screen 1
bind ^c screen 1
bind h select 1
bind j select 2
bind k select 3
bind l select 4
bind ; select 5



# ==========================================================
# 狀態列 (Status Bar) 顯示與位置
# 相當於: set -g status-position bottom
# ==========================================================
hardstatus alwayslastline

# ==========================================================
# 狀態列配色與格式 (Status & Window Style)
# 說明：
# %{= Wk} : 預設背景黑色 (k), 前景亮白色 (W) -> window-status-style
# %{= kY} : 背景亮黃色 (Y), 前景黑色 (k)     -> window-status-current-style
# [%S]    : 顯示 Session 名稱                -> wg_session
# %-w     : 顯示當前視窗之前的非使用中視窗清單
# %+w     : 顯示當前視窗之後的非使用中視窗清單
# %=      : 向右對齊 (相當於 tmux 的 status-right)
# %C      : 24小時制時間 (HH:MM)             -> wg_time
# ==========================================================
hardstatus string "%{= k.}[%S] %-w%{= Yk} %n%f %t %{-}%+w %= %{= k.}%C"
#hardstatus string '%{= kK}%{w}%H %{K}%= %{= kw}%?%-Lw%?%{B}(%{W}%n*%f %t%?(%u)%?%{B})%{w}%?%+Lw%?%?%= %{K}%{B} %{w}%c%{K}'
termcapinfo xterm* ti@:te@
altscreen on
defscrollback 10000



# 關閉啟動版權畫面（防止字元把游標往下推）
   startup_message off

   # 每次有終端機附著(Attach)時，強迫所有視窗重新適應當前終端機大小
   fit

   # 調整大小後自動觸發畫面重繪
   redisplay
