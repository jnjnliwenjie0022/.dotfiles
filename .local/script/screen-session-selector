#!/usr/bin/env bash

screen="screen" # GNU Screen 基礎指令

if [[ $# -eq 1 ]]; then
    selected=$1
else
    items=()
    items+=("$HOME")
    items+=($(find /NOBACKUP/$HOSTNAME/jasonli/*project* -mindepth 1 -maxdepth 1 -type d 2>/dev/null))
    selected=$(printf "%s\n" "${items[@]}" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# 將檔名轉換為符合 Screen 命名規則的名稱（移除點號與特殊字元）
selected_name=$(basename "$selected" | tr . _)

# 檢查 Screen 會話是否存在
if ! ${screen} -ls | grep -q "\.${selected_name}[[:space:]]"; then
    # 【修改點 1】
    # 不使用 -X chdir，而是直接在建立會話時讓初始視窗執行指令：
    # 先 cd 到目標目錄，執行 clear 清空背景緩衝區，最後 exec bash 進入互動式 Shell。
    # 這樣可以確保 Window 0 在正確目錄，且游標絕對在最頂端。
    ${screen} -d -m -S "$selected_name"
    ${screen} -S "$selected_name" -X chdir "$selected"
fi

# 判斷目前是否已經在某個 Screen 環境中
if [[ -z "${STY}" ]]; then
    # 如果不在 Screen 內：直接附著 (attach) 到該會話
    # 【修改點 2】加上 -A 參數，強制 Screen 依據你當下的終端機視窗大小重新調整佈局
    ${screen} -A -r "$selected_name"
else
    # 如果已經在 Screen 內：
    # 直接在目前視窗內開啟一個與目標會話連動的畫面
    # 【修改點 3】嵌套連線時同樣加上 -A 參數
    ${screen} -X screen ${screen} -A -r "$selected_name"
fi
